{
  "name": "operational-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:full": "node --env-file-if-exists=.env.local scripts/dev-stack.mjs",
    "build": "vite build",
    "test:access": "node scripts/test-access-control.mjs && node scripts/test-user-isolation.mjs && node scripts/test-hr-package-workflow.mjs && node scripts/test-research-workflow.mjs && node scripts/test-it-workspace.mjs && node scripts/test-workspace-resources.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "backend": "node --env-file-if-exists=.env.local server/index.mjs",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "airtable:export": "node --env-file=.env.local scripts/export-airtable.mjs",
    "airtable:attachments": "node scripts/download-airtable-attachments.mjs",
    "academy:catalog": "node scripts/build-academy-catalog.mjs",
    "academy:sync": "node --env-file=.env.local scripts/sync-academy-backend.mjs",
    "airtable:operational:sync": "node --env-file=.env.local scripts/sync-operational-airtable.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {}
}
